# Copy to .env for the Docker demo (docker compose reads it automatically).
# The first proctor account is created from these when the database has no accounts yet.
SMARTSQUAD_ADMIN_USER=proctor
SMARTSQUAD_ADMIN_PASSWORD=change-me-to-something-long

# Your timezone (a tz database name). Session times and alerts are recorded in this local time.
TZ=Asia/Kolkata
